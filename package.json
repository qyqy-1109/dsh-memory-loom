{
  "name": "dsh-memory-loom",
  "version": "0.65.1",
  "description": "yu（余）= 压缩之后剩下的那部分。给 DeepSeek Harness 的跨会话记忆与人格层：记忆有四层、写路径治理、按当前输入召回；人格有内核、原理账本、取舍账本和一块不给别人看的私人记录。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qyqy-1109/dsh-yu.git"
  },
  "homepage": "https://github.com/qyqy-1109/dsh-yu#readme",
  "bugs": {
    "url": "https://github.com/qyqy-1109/dsh-yu/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/growth.mjs",
    "scripts/wake.mjs",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "growth": "node scripts/growth.mjs",
    "wake": "node scripts/wake.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "cross-session",
    "memory-plugin",
    "persona",
    "identity",
    "self"
  ],
  "author": "卿云秋月",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
